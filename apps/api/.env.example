# Local API server
PORT=3001
WEB_ORIGIN=http://localhost:3000

# PostgreSQL connection credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Redis for BullMQ background jobs
REDIS_URL=redis://localhost:6379

# Google OAuth web client credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Gmail connector uses the same Google OAuth client, with a separate callback URI.
# Add this exact callback URL to the OAuth client's authorized redirect URIs.
# Enable the Gmail API and add approved demo accounts under OAuth audience test users.
GMAIL_GOOGLE_REDIRECT_URI=http://localhost:3001/connectors/gmail/google/callback
# 32-byte key encoded as 64 hexadecimal characters (generate with: openssl rand -hex 32)
GMAIL_TOKEN_ENCRYPTION_KEY=

# Generate a long random value for signing application sessions
SESSION_SECRET=

# OpenAI API credentials for the case intake agent
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Private case attachment storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
